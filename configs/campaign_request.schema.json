{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Universal Product Campaign Request",
  "type":"object",
  "required":["product_id"],
  "oneOf":[{"required":["product_asset"],"not":{"required":["product_image"]}},{"required":["product_image"],"not":{"required":["product_asset"]}}],
  "properties":{
    "product_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "product_image":{"type":"string"},
    "product_asset":{"oneOf":[{"type":"string"},{"type":"object","required":["segmentation_result"],"properties":{"segmentation_result":{"type":"string"}}}]},
    "instance_selection":{"type":"object","properties":{"roi":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer"}},"single_instance":{"type":"boolean"}}},
    "product_category":{"type":["string","null"]},
    "product_facts":{"type":"object","description":"Per-property Evidence value/status/method/reviewer plus provenance.product_id, kind and statement. Unknown values must be null."},
    "reference_url":{"type":["string","null"]},
    "reference_images":{"oneOf":[{"type":"string"},{"type":"array","items":{"type":"string"}}]},
    "reference_catalog":{"type":"string"},
    "reference_analysis":{"type":"string"},
    "agent_analysis":{"type":"string","description":"Hash-bound product_understanding.4b.1 from an image-capable Agent; missing analysis produces a paused handoff, not fabricated success."},
    "style_preference":{"type":"object"},
    "platform":{"enum":["amazon","ebay","generic","social"],"default":"generic"},
    "language":{"enum":["en","zh"],"default":"en"},
    "output_count":{"type":"integer","minimum":1,"maximum":11,"default":6},
    "output_sizes":{"type":"object","additionalProperties":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":512,"maximum":3072,"multipleOf":8}}},
    "shot_types":{"type":"array","items":{"enum":["white_hero","studio_photo","brand_signature","feature_infographic","material_detail","structure_explainer","specifications","lifestyle_scene","editorial_campaign","wide_banner","comparison"]}},
    "creation_modes":{"type":"array","minItems":1,"items":{"enum":["evidence_preserving","concept_creative"]},"default":["evidence_preserving"]},
    "generation_budget":{"type":"object","properties":{"max_new_backgrounds":{"type":"integer","minimum":0,"maximum":3}}},
    "review_policy":{"type":"object","properties":{"mode":{"enum":["auto","strict","preview"]}}},
    "scene":{"type":"object","properties":{"level":{"enum":[1,2,3]},"presentation":{"type":"string"},"physical_contact":{"type":"boolean"},"holding":{"type":"boolean"},"wearing":{"type":"boolean"},"occlusion":{"type":"boolean"}}},
    "output_dir":{"type":"string"},
    "reuse_backgrounds_from":{"type":"string","description":"Parent campaign directory; cache keys still enforce source/instance/mask/workflow/prompt/mode binding."},
    "comfyui_config":{"type":"string"},
    "segmentation_python":{"type":"string"}
  },
  "additionalProperties":true
}
